# Retrieval works without a provider key. Copy to .env; never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
RUYA_ENABLE_GENERATION=false
RUYA_ALLOW_EXPERIMENTAL_SEARCH=false
RUYA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RUYA_PROVIDER_TIMEOUT_SECONDS=30
RUYA_MAX_OUTPUT_TOKENS=900
RUYA_MAX_PROMPT_BYTES=16000
RUYA_MAX_CONTEXT_CHARS=6000
RUYA_GENERATION_CALLS_PER_MINUTE=5
